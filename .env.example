# Environment template for the Ambient Harness.
#
# Copy to `.env` (git-ignored) and fill in before running the harness.
# The repository is design-stage: nothing reads these yet, but they are the
# variables the runtime will need, kept here so an agent knows what to provide.
# Add new variables here (without secrets) whenever code starts reading one.

# --- Model provider (the Validator/Worker run against a real model) ---
# API key for the model provider used by the orchestrator.
MODEL_API_KEY=

# --- whatsappd substrate ---
# Path or address of the whatsappd session engine this harness attaches to.
# See docs/overview.md and docs/adr/0012-the-runtime-split.md.
WHATSAPPD_ENDPOINT=
